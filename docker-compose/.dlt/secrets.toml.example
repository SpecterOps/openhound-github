[destination.bloodhoundenterprise]
url = "https://REPLACE_WITH_TENANT.bloodhoundenterprise.io"
# Credentials for the GitHub OpenHound collector client in BHE.
token_id = "REPLACE_WITH_BHE_COLLECTOR_TOKEN_ID"
token_key = "REPLACE_WITH_BHE_COLLECTOR_TOKEN_KEY"

[sources.source.github.credentials]
client_id = "REPLACE_WITH_GITHUB_APP_CLIENT_ID"
enterprise_name = "REPLACE_WITH_ENTERPRISE_SLUG"
key_path = "/app/.dlt/github-app.pem"
# Optional classic PAT for enterprise SAML SSO and SCIM collection:
# pat_token = "REPLACE_WITH_OPTIONAL_PAT"
